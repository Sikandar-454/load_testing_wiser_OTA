            </stringProp>
            <stringProp name="script">// Generate timestamp (seconds)
def ts = (System.currentTimeMillis() / 1000) as long

vars.put("ts", ts.toString())

log.info("TS value: " + ts)
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
